{
  "name": "danhk0612/dk-annual-manager",
  "description": "PHP + MariaDB annual leave and vacation management system",
  "type": "project",
  "require": {
    "php": ">=8.2",
    "ext-curl": "*",
    "ext-json": "*",
    "ext-pdo": "*",
    "guzzlehttp/guzzle": "^7.9",
    "firebase/php-jwt": "^6.11"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "DKAnnual\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "DKAnnual\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "config": {
    "sort-packages": true
  }
}
